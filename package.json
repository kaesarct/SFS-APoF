{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node -e \"const fs=require('fs');const h=fs.readFileSync('dist/frontend/browser/index.csr.html','utf8');fs.writeFileSync('dist/frontend/browser/404.html',h.replace('</head>','  <meta name=\\\"robots\\\" content=\\\"noindex, nofollow\\\">\\n</head>'))\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/fire": "^21.0.0",
    "@angular/forms": "^21.2.26",
    "@angular/localize": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/ssr": "^21.2.31",
    "chart.js": "^4.5.1",
    "echarts": "^6.1.0",
    "firebase": "^12.19.0",
    "flag-icons": "^7.5.0",
    "ngx-echarts": "^21.0.0",
    "rxjs": "~7.8.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "world-atlas": "^2.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "^21.2.31",
    "@angular/cli": "^21.2.31",
    "@angular/compiler-cli": "^21.2.26",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.4.24",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "~4.0.18"
  }
}
